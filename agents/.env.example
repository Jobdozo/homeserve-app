# Copy to .env for local runs. In production put these in the VPS .env that
# docker-compose reads (never commit real values).

# Tikdum API as seen from the worker (compose runs both on the host network).
TIKDUM_API_URL=http://127.0.0.1:4000/api

# Keys shown once when you create each agent in Admin -> AI Agents.
AGENT_KEY_OPERATIONS=
AGENT_KEY_REPORTING=
AGENT_KEY_COMPLAINTS=
AGENT_KEY_SUPPORT=
AGENT_KEY_REGISTRATION=
AGENT_KEY_VERIFICATION=
AGENT_KEY_PAYMENTS=

# Claude API (only the Reporting agent uses it in Phase 1).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_INPUT_USD_PER_MTOK=1
ANTHROPIC_OUTPUT_USD_PER_MTOK=5

# Reporting
REPORT_HOUR_IST=9
REPORT_WHATSAPP=true

# Operations thresholds (minutes unless noted)
OPS_CHECK_EVERY_SEC=300
OPS_PENDING_STUCK_MIN=15
OPS_LATE_MIN=30
OPS_LATE_CRITICAL_MIN=90
OPS_LONG_JOB_MIN=360
OPS_LOOKBACK_HOURS=48
OPS_NUDGE_PROVIDERS=true

# Complaint Triage
COMPLAINTS_CHECK_EVERY_SEC=180
COMPLAINTS_MAX_PER_RUN=10
COMPLAINTS_LOOKBACK_DAYS=7
COMPLAINTS_PROPOSE_REPLIES=true
COMPLAINTS_MIN_CONFIDENCE=0.6

# Customer Support (WhatsApp)
SUPPORT_CHECK_EVERY_SEC=20
SUPPORT_MAX_PER_RUN=10

# Registration follow-ups (no AI)
REGISTRATION_CHECK_EVERY_MIN=60
REGISTRATION_DIGEST_HOUR_IST=10
REGISTRATION_NUDGE_EVERY_HOURS=48
REGISTRATION_MAX_NUDGES=3
REGISTRATION_LOOKBACK_DAYS=7

# Verification pre-check (no AI)
VERIFICATION_CHECK_EVERY_MIN=15

# Payments reconciliation (no AI, read-only)
PAYMENTS_CHECK_EVERY_MIN=360
PAYMENTS_REPORT_HOUR_IST=8
